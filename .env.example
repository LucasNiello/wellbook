# .env da RAIZ: só para scripts (ex.: supabase/scripts/criar-usuarios-seed.ts).
# Copie para .env e preencha os valores reais. O .env está no .gitignore e NUNCA pode ser commitado.
# Os apps têm arquivos próprios (Fase 3): apps/web/.env.local (NEXT_PUBLIC_*) e apps/mobile/.env (EXPO_PUBLIC_*).

# URL do projeto
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
# Chave publicável (sb_publishable_…): pública, protegida pela RLS
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<sua-chave-publicavel>
# Chave secreta (sb_secret_… ou a service_role antiga). NUNCA no app nem em commit.
SUPABASE_SECRET_KEY=
# Senha de todas as contas de teste do seed (mínimo 8 caracteres)
SEED_SENHA=
